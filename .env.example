# Bot identity (GET /v1/metadata)
TEAM_NAME=Vera++
TEAM_MEMBERS=Your Name
CONTACT_EMAIL=you@example.com
BOT_VERSION=1.0.0

# Optional: grounded LLM for free-form merchant questions (bot is fully functional without it)
# LLM_PROVIDER=anthropic          # or: openai (any OpenAI-compatible endpoint)
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT=7

# Optional: survive restarts mid-test (JSON snapshot; deleted on /v1/teardown)
# STATE_FILE=/tmp/vera_state.json
